# Environment variables for Railway deployment

# Firebase Admin SDK Credentials (JSON string)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Then stringify the JSON and paste here
FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"your-project",...}'

# Optional: Vercel domain for CORS
VERCEL_DOMAIN=spotify-tempo-dashboard.vercel.app

# Railway environment flag
RAILWAY_ENVIRONMENT=true

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=False

# API Port (Railway will inject this automatically)
PORT=5000
