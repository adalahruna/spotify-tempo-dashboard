{
  "version": 2,
  "builds": [
    {
      "src": "api/search_api.py",
      "use": "@vercel/python"
    },
    {
      "src": "dashboard/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/search_api.py"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "dashboard/$1"
    },
    {
      "src": "/",
      "dest": "dashboard/index.html"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
